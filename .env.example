# Admin bootstrap (used on first run only — creates admin user in DB)
DARKREEL_ADMIN_USERNAME=admin
DARKREEL_ADMIN_PASSWORD=

# Per-user storage quota in GB (default: 1 GB if not set)
MAX_STORAGE_GB=50

# Session persistence: keep the (non-extractable) keys in IndexedDB so a page
# refresh doesn't require logging in again. false = log in after every refresh.
PERSIST_SESSION=false

# User registration via web UI (default: disabled)
ALLOW_REGISTRATION=false

# CLI flags (not env vars):
#   -addr 127.0.0.1:8080   Listen address (default; keep it on loopback behind a proxy)
#   -data ./data      Data directory for encrypted files and database
